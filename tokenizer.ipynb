   "source": [
    "from transformers import AutoTokenizer\n",
    "tokenizer=AutoTokenizer.from_pretraied(\"\")\n",
    "tokens=tokenizer.tokenizer(text)\n",
    "print(\"Tokens\",tokens)\n",
    "tokens_id=tokenizer"
   ]
  },
